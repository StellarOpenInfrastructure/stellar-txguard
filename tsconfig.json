{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stellar-txguard/core": ["packages/core/src/index.ts"],
      "@stellar-txguard/sdk": ["packages/sdk/src/index.ts"]
    },
    "rootDir": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "backend/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "frontend"]
}
