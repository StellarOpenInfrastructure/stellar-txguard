# stellar-txguard API configuration. Copy to .env for local development.
# Placeholder values only — never commit real credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=4010
LOG_LEVEL=info

# testnet | mainnet | custom
STELLAR_NETWORK=testnet
# Required for mainnet (bring your own provider) or custom networks.
# STELLAR_RPC_URL=https://your-rpc-provider.example/rpc
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Directory of YAML policies loaded at startup.
POLICY_DIR=./examples/policies

# Simulate Soroban transactions via RPC before policy evaluation.
SIMULATION_ENABLED=false

# medium | high | critical — allowed transactions at/above this risk level are marked "review".
REVIEW_AT_RISK_LEVEL=high

# Comma-separated origins, or * for development.
CORS_ORIGINS=*
