{
  "openapi": "3.1.0",
  "info": {
    "title": "stellar-txguard API",
    "description": "Transaction policy, simulation and risk firewall for Stellar applications.",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "version"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe (checks upstream Stellar RPC when configured)",
        "tags": ["system"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready"]
                    },
                    "checks": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["status", "checks"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["not_ready"]
                    },
                    "checks": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["status", "checks"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "summary": "List policies",
        "tags": ["policies"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "required": ["id", "name"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["items"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a policy (in-memory in this scaffold)",
        "tags": ["policies"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "number",
                    "enum": [1]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "on_violation": {
                    "default": "deny",
                    "type": "string",
                    "enum": ["deny", "review"]
                  },
                  "rules": {
                    "type": "object",
                    "properties": {
                      "max_amount": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "asset": {
                              "default": "*",
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^\\d+(\\.\\d{1,7})?$"
                            }
                          },
                          "required": ["amount"]
                        }
                      },
                      "allowed_assets": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                        }
                      },
                      "blocked_assets": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                        }
                      },
                      "allowed_destinations": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[GCM][A-Z2-7]{55}$"
                        }
                      },
                      "required_memo": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "types": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": ["text", "id", "hash", "return"]
                                }
                              }
                            },
                            "required": ["types"]
                          }
                        ]
                      },
                      "simulation_required": {
                        "type": "boolean"
                      },
                      "contract_allowlist": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^C[A-Z2-7]{55}$"
                        }
                      },
                      "daily_limit": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "asset": {
                              "default": "*",
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                            },
                            "amount": {
                              "type": "string",
                              "pattern": "^\\d+(\\.\\d{1,7})?$"
                            }
                          },
                          "required": ["amount"]
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"
                  }
                },
                "required": ["version", "name", "rules", "id"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "number",
                      "enum": [1]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "on_violation": {
                      "default": "deny",
                      "type": "string",
                      "enum": ["deny", "review"]
                    },
                    "rules": {
                      "type": "object",
                      "properties": {
                        "max_amount": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "asset": {
                                "default": "*",
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                              },
                              "amount": {
                                "type": "string",
                                "pattern": "^\\d+(\\.\\d{1,7})?$"
                              }
                            },
                            "required": ["asset", "amount"],
                            "additionalProperties": false
                          }
                        },
                        "allowed_assets": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                          }
                        },
                        "blocked_assets": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                          }
                        },
                        "allowed_destinations": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[GCM][A-Z2-7]{55}$"
                          }
                        },
                        "required_memo": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "types": {
                                  "minItems": 1,
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "enum": ["text", "id", "hash", "return"]
                                  }
                                }
                              },
                              "required": ["types"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "simulation_required": {
                          "type": "boolean"
                        },
                        "contract_allowlist": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^C[A-Z2-7]{55}$"
                          }
                        },
                        "daily_limit": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "asset": {
                                "default": "*",
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                              },
                              "amount": {
                                "type": "string",
                                "pattern": "^\\d+(\\.\\d{1,7})?$"
                              }
                            },
                            "required": ["asset", "amount"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-_]{0,63}$"
                    }
                  },
                  "required": ["version", "name", "on_violation", "rules", "id"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
