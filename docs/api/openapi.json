    "/api/v1/inspect": {
      "post": {
        "summary": "Parse, simulate, policy-check and risk-score a transaction envelope",
        "tags": ["inspection"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "envelopeXdr": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200000
                  },
                  "networkPassphrase": {
                    "type": "string"
                  },
                  "policyId": {
                    "type": "string"
                  },
                  "policy": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "number",
                        "enum": [1]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "on_violation": {
                        "default": "deny",
                        "type": "string",
                        "enum": ["deny", "review"]
                      },
                      "rules": {
                        "type": "object",
                        "properties": {
                          "max_amount": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "asset": {
                                  "default": "*",
                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                                },
                                "amount": {
                                  "type": "string",
                                  "pattern": "^\\d+(\\.\\d{1,7})?$"
                                }
                              },
                              "required": ["amount"]
                            }
                          },
                          "allowed_assets": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                            }
                          },
                          "blocked_assets": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                            }
                          },
                          "allowed_destinations": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[GCM][A-Z2-7]{55}$"
                            }
                          },
                          "required_memo": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "types": {
                                    "minItems": 1,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "enum": ["text", "id", "hash", "return"]
                                    }
                                  }
                                },
                                "required": ["types"]
                              }
                            ]
                          },
                          "simulation_required": {
                            "type": "boolean"
                          },
                          "contract_allowlist": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^C[A-Z2-7]{55}$"
                            }
                          },
                          "daily_limit": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "asset": {
                                  "default": "*",
                                  "type": "string",
                                  "minLength": 1,
                                  "pattern": "^(\\*|native|[A-Za-z0-9]{1,12}:G[A-Z2-7]{55}|contract:C[A-Z2-7]{55})$"
                                },
                                "amount": {
                                  "type": "string",
                                  "pattern": "^\\d+(\\.\\d{1,7})?$"
                                }
                              },
                              "required": ["amount"]
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": ["version", "name", "rules"],
                    "additionalProperties": false
                  },
                  "skipSimulation": {
                    "type": "boolean"
                  },
                  "knownDestinations": {
                    "maxItems": 10000,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "knownContracts": {
                    "maxItems": 10000,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["envelopeXdr"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transaction": {
                      "type": "object",
                      "properties": {
                        "networkPassphrase": {
                          "type": "string"
                        },
                        "hash": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "fee": {
                          "type": "string"
                        },
                        "sequence": {
                          "type": "string"
                        },
                        "memo": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": ["none", "text", "id", "hash", "return"]
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": ["type"],
                          "additionalProperties": false
                        },
                        "timeBounds": {
                          "type": "object",
                          "properties": {
                            "minTime": {
                              "type": "string"
                            },
                            "maxTime": {
                              "type": "string"
                            }
                          },
                          "required": ["minTime", "maxTime"],
                          "additionalProperties": false
                        },
                        "operations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "index": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "type": {
                                "type": "string"
                              },
                              "source": {
                                "type": "string"
                              },
                              "transfers": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "destination": {
                                      "type": "string"
                                    },
                                    "asset": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "properties": {
                                            "type": {
                                              "type": "string",
                                              "enum": ["native"]
                                            },
                                            "code": {
                                              "type": "string",
                                              "enum": ["XLM"]
                                            }
                                          },
                                          "required": ["type", "code"],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "type": {
                                              "type": "string",
                                              "enum": ["credit_alphanum4", "credit_alphanum12"]
                                            },
                                            "code": {
                                              "type": "string"
                                            },
                                            "issuer": {
                                              "type": "string"
                                            }
                                          },
                                          "required": ["type", "code", "issuer"],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "object",
                                          "properties": {
                                            "type": {
                                              "type": "string",
                                              "enum": ["contract"]
                                            },
                                            "contractId": {
                                              "type": "string"
                                            }
                                          },
                                          "required": ["type", "contractId"],
                                          "additionalProperties": false
                                        }
                                      ]
                                    },
                                    "amount": {
                                      "type": "string"
                                    }
                                  },
                                  "required": ["destination", "asset", "amount"],
                                  "additionalProperties": false
                                }
                              },
                              "contract": {
                                "type": "object",
                                "properties": {
                                  "contractId": {
                                    "type": "string"
                                  },
                                  "functionName": {
                                    "type": "string"
                                  },
                                  "hostFunctionType": {
                                    "type": "string",
                                    "enum": ["invoke_contract", "create_contract", "upload_wasm"]
                                  }
                                },
                                "required": ["hostFunctionType"],
                                "additionalProperties": false
                              }
                            },
                            "required": ["index", "type", "transfers"],
                            "additionalProperties": false
                          }
                        },
                        "feeBump": {
                          "type": "object",
                          "properties": {
                            "feeSource": {
                              "type": "string"
                            },
                            "fee": {
                              "type": "string"
                            }
                          },
                          "required": ["feeSource", "fee"],
                          "additionalProperties": false
